<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.2.0</Version>
		<Description>Jakar.Json for MassTransit: messages of [JsonModel] types are written and read by Jakar.Json inside MassTransit's JSON envelope (the System.Text.Json serializer, configured with Jakar.Json.SystemTextJson).</Description>
		<PackageTags>json masstransit messaging bus serializer source-generator</PackageTags>
		<PackageReleaseNotes>10.2.0: built against Jakar.Json 10.2.0, whose writers take a ref TWriter; 10.1.0 calls the removed IBufferWriter overloads and throws MissingMethodException with Jakar.Json 10.2.0. 10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="MassTransit" />
		<ProjectReference Include="..\Jakar.Json.SystemTextJson\Jakar.Json.SystemTextJson.csproj" />
	</ItemGroup>
</Project>
