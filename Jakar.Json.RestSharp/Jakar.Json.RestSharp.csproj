<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.2.0</Version>
		<Description>Jakar.Json as RestSharp's serializer: request and response bodies of [JsonModel] types (and collections of them) are written and read by Jakar.Json, responses straight from their bytes; other types go to a fallback (RestSharp's System.Text.Json serializer by default).</Description>
		<PackageTags>json restsharp rest http client serializer source-generator utf8</PackageTags>
		<PackageReleaseNotes>10.2.0: built against Jakar.Json 10.2.0, whose writers take a ref TWriter; 10.1.0 calls the removed IBufferWriter overloads and throws MissingMethodException with Jakar.Json 10.2.0. 10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="RestSharp" />
	</ItemGroup>
</Project>
