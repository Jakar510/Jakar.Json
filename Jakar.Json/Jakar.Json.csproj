<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<!-- Jakar.Json's own types use the Jakar.Json namespace; [JsonModel] stays in Jakar.Extensions. -->
		<RootNamespace>Jakar.Json</RootNamespace>
		<AssemblyName>Jakar.Json</AssemblyName>
		<Version>10.3.0</Version>
		<Title>Jakar.Json</Title>
		<PackageId>Jakar.Json</PackageId>
		<Authors>Tyler Stegmaier</Authors>
		<Description>A standalone, reflection-free, allocation-free JSON serializer: [JsonModel] source-generates idempotent readers and writers (UTF-16 and UTF-8) that implement ISpanFormattable / ISpanParsable, plus a zero-allocation JSON tape and a Newtonsoft-style DOM. No dependency on System.Text.Json.</Description>
		<PackageTags>json serializer source-generator aot trimming zero-allocation utf8 ndjson</PackageTags>
		<PackageReleaseNotes>10.3.0 (breaking): System.Text.Json is gone. [JsonModel] no longer takes a JsonSerializerContext (JsonModelContextAttribute, JsonModelImplementation, IJsonModel&lt;TSelf&gt;, JsonModel, JsonModelRegistry, RentedArray&lt;T&gt;, SerializeAsStringJsonConverter&lt;T&gt; and JsonElementConverter are removed; JJSON016/017 retired), JsonReadException derives from Exception (Path, LineNumber and BytePositionInLine kept), and System.Text.Json attributes are no longer read: use [JsonKey], [JsonOrder], [JsonSkip], [JsonMandatory], [JsonOptIn], [JsonOverflow] (extension data: OrderedDictionary&lt;string, JNode?&gt; or JObjectNode, get-only bags too) and [JsonCreator]. NonFiniteFloats defaults to AsString: NaN and ±Infinity round-trip as "NaN", "Infinity", "-Infinity", and JNode holds them. New ReadOnlyMembers setting ([JsonModel], [assembly: JsonDefaults], [JsonMember(ReadOnly)]) ignores computed get-only members. 10.2.0 (breaking): buffer writers are generic and passed by ref, so struct and ref struct writers work without boxing: JsonCodec.WriteJson&lt;T, TWriter&gt;(in T, ref TWriter) (UTF-8), JsonCodec.WriteJsonUtf16&lt;T, TWriter&gt;(in T, ref TWriter), JsonCodec.WriteJsonArray&lt;T, TWriter&gt;(..., ref TWriter), JsonTypeCodec.Write&lt;TWriter&gt;(object?, ref TWriter), and the generated WriteJson&lt;TWriter&gt;(ref TWriter); the IBufferWriter&lt;byte|char&gt; overloads are gone. 10.1.0: initial release. Absorbs Jakar.SystemTextJson (IJsonModel&lt;TSelf&gt;, [JsonModel], JsonModel, RentedArray&lt;T&gt;, SerializeAsStringJsonConverter&lt;T&gt;; still in the Jakar.Extensions namespace, diagnostics JAKAR_JSON001-007 unchanged). One attribute, [JsonModel]: without a System.Text.Json context it's Jakar.Json only; with one it implements IJsonModel&lt;TSelf&gt; on Jakar.Json when that supports the type (faster, fewer allocations; the context's options mirrored), otherwise on System.Text.Json (JJSON016). [GenerateJson] and JJSON010 are gone.</PackageReleaseNotes>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Jakar510/Jakar.Json</RepositoryUrl>
		<PackageProjectUrl>https://github.com/Jakar510/Jakar.Json</PackageProjectUrl>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<WarningsAsErrors>Nullable;IL2026;IL2046;IL2057;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL2111;IL3050;IL3051</WarningsAsErrors>
		<IsAotCompatible>true</IsAotCompatible>
		<!-- [module: SkipLocalsInit] (GlobalUsings.cs) needs it; no unsafe code otherwise. -->
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<!-- Keep the JetBrains annotations ([MustDisposeResource], [Pure], ...) in the compiled metadata so Rider/ReSharper users see them. -->
		<DefineConstants>$(DefineConstants);JETBRAINS_ANNOTATIONS</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Jakar.Spans" />
	</ItemGroup>

	<!-- The generator, analyzers and code fixes ship inside this package (analyzers/dotnet/cs). -->
	<ItemGroup>
		<ProjectReference Include="..\Jakar.Json.Generator\Jakar.Json.Generator.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
		<ProjectReference Include="..\Jakar.Json.Generator.CodeFixes\Jakar.Json.Generator.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Jakar.Json.Tests" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Jakar.Json.Generator\bin\$(Configuration)\netstandard2.0\Jakar.Json.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\Jakar.Json.Generator.CodeFixes\bin\$(Configuration)\netstandard2.0\Jakar.Json.Generator.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="..\images\icon.png" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" Visible="false" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
