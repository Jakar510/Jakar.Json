<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.2.0</Version>
		<Description>Jakar.Json for Marten (PostgreSQL document database and event store): documents and events of [JsonModel] types are written and read by Jakar.Json through Marten's System.Text.Json serializer.</Description>
		<PackageTags>json marten postgresql jsonb document-database event-sourcing serializer source-generator</PackageTags>
		<PackageReleaseNotes>10.2.0: built against Jakar.Json 10.2.0, whose writers take a ref TWriter; 10.1.0 calls the removed IBufferWriter overloads and throws MissingMethodException with Jakar.Json 10.2.0. 10.1.0: initial release.</PackageReleaseNotes>
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Marten" />
		<ProjectReference Include="..\Jakar.Json.SystemTextJson\Jakar.Json.SystemTextJson.csproj" />
	</ItemGroup>
</Project>
