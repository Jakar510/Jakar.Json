<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json for SignalR's JSON hub protocol: hub method arguments and results of [JsonModel] types are written and read by Jakar.Json, on servers and .NET clients alike.</Description>
		<PackageTags>json signalr realtime websockets hub-protocol source-generator</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" />
		<ProjectReference Include="..\Jakar.Json.SystemTextJson\Jakar.Json.SystemTextJson.csproj" />
	</ItemGroup>
</Project>
