<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.2.0</Version>
		<Description>Jakar.Json for Serilog: [JsonModel] values logged with {@Value} are destructured with the names and shape Jakar.Json writes them in, instead of by reflection.</Description>
		<PackageTags>json serilog logging structured-logging destructuring source-generator</PackageTags>
		<PackageReleaseNotes>10.2.0: built against Jakar.Json 10.2.0, whose writers take a ref TWriter; 10.1.0 calls the removed IBufferWriter overloads and throws MissingMethodException with Jakar.Json 10.2.0. 10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Serilog" />
	</ItemGroup>
</Project>
