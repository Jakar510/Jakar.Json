<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.2.0</Version>
		<Description>Jakar.Json for HttpClient: JakarJsonContent and GetFromJakarJsonAsync / PostAsJakarJsonAsync / PutAsJakarJsonAsync / PatchAsJakarJsonAsync / ReadFromJakarJsonAsync, in the shape of System.Net.Http.Json, streaming [JsonModel] types with no reflection.</Description>
		<PackageTags>json httpclient http rest client source-generator aot zero-allocation utf8</PackageTags>
