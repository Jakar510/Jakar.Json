<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Jakar.Spans until it's on nuget.org: dotnet pack, then nuget add <nupkg> -Source W:\WorkSpace\LocalNuGet -->
    <add key="LocalNuGet" value="W:\WorkSpace\LocalNuGet" />
  </packageSources>
</configuration>
