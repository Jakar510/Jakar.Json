<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f701d4ef-4568-4a3c-b702-af7abd4c2378</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jakar.Json.AspNetCore\Jakar.Json.AspNetCore.csproj" />
    <!-- The [JsonModel] generator comes with the Jakar.Json package, through Jakar.Json.AspNetCore. -->
  </ItemGroup>

  <!-- The [JsonModel] generator: through the referenced package in Release, the repository's generator otherwise. -->
  <PropertyGroup>
    <JakarJsonGeneratorOnly>true</JakarJsonGeneratorOnly>
  </PropertyGroup>

  <Import Project="..\Shared\JakarJson.props" />
</Project>
