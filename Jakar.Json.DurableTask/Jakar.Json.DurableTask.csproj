<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json as the Durable Task (Durable Functions / Durable Task Scheduler) data converter: orchestration and activity inputs and outputs of [JsonModel] types are written and read by Jakar.Json; other types go to a fallback.</Description>
		<PackageTags>json durabletask durable-functions orchestration data-converter source-generator</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Microsoft.DurableTask.Abstractions" />
	</ItemGroup>
</Project>
