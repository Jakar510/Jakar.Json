<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json as Refit's content serializer: request and response bodies of [JsonModel] types (and collections of them) are written and read by Jakar.Json; other types go to a fallback (Refit's System.Text.Json serializer by default).</Description>
		<PackageTags>json refit rest http client serializer source-generator aot zero-allocation utf8</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Refit" />
		<ProjectReference Include="..\Jakar.Json.Http\Jakar.Json.Http.csproj" />
	</ItemGroup>
</Project>
