<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json as an Akka.NET serializer: messages and persisted events of [JsonModel] types are written and read by Jakar.Json, bound by configuration or SerializationSetup.</Description>
		<PackageTags>json akka akka.net actors persistence remoting serializer source-generator</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Akka" />
	</ItemGroup>
</Project>
