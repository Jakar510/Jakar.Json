<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json as the EasyNetQ (RabbitMQ) message serializer: [JsonModel] messages are written into pooled buffers EasyNetQ owns and read straight from the delivery; other types go to a fallback.</Description>
		<PackageTags>json easynetq rabbitmq messaging serializer source-generator aot zero-allocation utf8</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="EasyNetQ" />
	</ItemGroup>
</Project>
