<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Version>10.1.0</Version>
		<Description>Jakar.Json as the Elasticsearch .NET client's source serializer: documents (_source) of [JsonModel] types are written and read by Jakar.Json; other types go to the client's default System.Text.Json source serializer.</Description>
		<PackageTags>json elasticsearch elastic search source-serializer source-generator</PackageTags>
		<PackageReleaseNotes>10.1.0: initial release.</PackageReleaseNotes>
		<!-- The Elasticsearch client isn't trimming-safe. -->
		<IsAotCompatible>false</IsAotCompatible>
	</PropertyGroup>

	<Import Project="..\Shared\Integration.props" />

	<ItemGroup>
		<PackageReference Include="Elastic.Clients.Elasticsearch" />
	</ItemGroup>
</Project>
